            <column caption='Segment Type' datatype='string' name='[Calculation_1035772642480128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF UPPER([LIFESTAGE]) = &apos;YOUNG SINGLES/COUPLES&apos; AND UPPER([PREMIUM_CUSTOMER]) = &apos;MAINSTREAM&apos; &#13;&#10;THEN &apos;Target&apos; &#13;&#10;ELSE &apos;Other&apos; &#13;&#10;END' />
            </column>
            <column caption='Affinity Index' datatype='real' name='[Calculation_1035772650627077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_1035772642480128] = &apos;Target&apos; THEN [TOT_SALES] ELSE 0 END) / SUM({SUM(IF [Calculation_1035772642480128] = &apos;Target&apos; THEN [TOT_SALES] ELSE 0 END)}))&#13;&#10;/&#13;&#10;(SUM(IF [Calculation_1035772642480128] = &apos;Other&apos; THEN [TOT_SALES] ELSE 0 END) / SUM({SUM(IF [Calculation_1035772642480128] = &apos;Other&apos; THEN [TOT_SALES] ELSE 0 END)}))' />
